# Variables de entorno para Ecos
# Copiá este archivo a .env.local y completá los secretos.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
APP_RPC_SECRET=generate-a-long-random-hex
CEDULA_HMAC_SECRET=generate-a-long-random-hex
VOTE_TOKEN_SECRET=generate-a-long-random-hex

# mock = MVP / pruebas (valida formato de cédula, no llama al TSJE)
# live = consulta real al padrón (requiere cookie WAF o PADRON_BROWSER=1)
PADRON_MODE=mock
PADRON_MOCK_DISTRICT=YAGUARON
PADRON_MOCK_REJECT=9999999
# PADRON_ALLOWED_DISTRICT=YAGUARON
# PADRON_BROWSER=1
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Cloudflare Turnstile (opcional en mock). En live conviene activarlo.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
