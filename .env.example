# Variables de entorno para Ecos
# Copiá este archivo a .env.local y completá los secretos.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
APP_RPC_SECRET=generate-a-long-random-hex
CEDULA_HMAC_SECRET=generate-a-long-random-hex
VOTE_TOKEN_SECRET=generate-a-long-random-hex

# mock = pruebas locales sin seed (valida formato de cédula)
# db = lookup contra private.padron_electores (requiere npm run seed:padron)
PADRON_MODE=mock
PADRON_MOCK_DISTRICT=YAGUARON
PADRON_MOCK_REJECT=9999999
# PADRON_ALLOWED_DISTRICT=YAGUARON

# Ensayo: permite votar más de una vez. En producción no lo definas o dejalo en false.
# ALLOW_REPEAT_VOTES=false

# Solo preview/local. En Vercel Production se ignoran: el cierre real es elections.closes_at
# (16 sep 2026 23:59 hora Paraguay). Las últimas 24h y el acta salen solos.
# FORCE_SURVEY_CLOSED=true
# PREVIEW_CLOSE_COUNTDOWN=true

# Connection string de Postgres (Settings → Database en Supabase). Solo para npm run reset:survey.
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Solo local: cédula/fecha propias para `npm run check:padron`. No las commitees.
# CHECK_PADRON_CEDULA=
# CHECK_PADRON_DOB=1990-01-01

# Cloudflare Turnstile. Obligatorio: sin estas claves el voto no se acepta.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me
